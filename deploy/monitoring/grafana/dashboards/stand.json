          "editorMode": "code",
          "expr": "sum(rate(haproxy_frontend_http_responses_total{proxy=\"https\",code=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(haproxy_frontend_http_responses_total{proxy=\"https\"}[$__rate_interval])), 0.001)",
