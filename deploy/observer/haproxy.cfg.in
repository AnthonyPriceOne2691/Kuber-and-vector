# HAProxy на machine-4: вход стенда, в облаке на его месте был бы балансировщик провайдера.
# Снаружи открыт только 443 (TLS). API Kubernetes и статистика слушают только localhost машины.
# Поиск и ответ только по ключу API (заголовок X-API-Key, список ключей в /etc/haproxy/api-keys.map,
# его создаёт install.sh); перебор ключей и слишком частые запросы с одного адреса получают 429.
# Строки серверов (@SEARCH_SERVERS@, @ANSWER_SERVERS@, @API_SERVERS@) подставляет install.sh по адресам узлов.
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 300ms
    timeout client 30s
    timeout server 3s
    timeout http-request 5s
    timeout http-keep-alive 5s
    timeout queue 2s
    timeout check 500ms
    # Поиск без побочных эффектов: неудачный запрос повторяем, каждый раз на другой машине
    retries 2
    option redispatch 1

frontend https
    bind :443 ssl crt /etc/haproxy/certs/stand.pem alpn h2,http/1.1
    # счётчики по адресу источника за 10 с: темп запросов и отказы по ключу
    stick-table type ip size 100k expire 60s store http_req_rate(10s),gpc0,gpc0_rate(10s)
    http-request track-sc0 src
    http-request deny deny_status 405 unless METH_GET
    http-request deny deny_status 404 unless { path /search /answer /healthz }
    # перебор ключей: больше 10 отказов за 10 с, и адрес получает 429 на всё, пока счётчик не остынет
    http-request return status 429 content-type application/json string '{"error":"слишком много отказов по ключу, подождите"}' if { sc_gpc0_rate(0) gt 10 }
    # потолок темпа с одного адреса: 600 запросов за 10 с
    http-request return status 429 content-type application/json string '{"error":"слишком много запросов"}' if { sc_http_req_rate(0) gt 600 }
    acl api_path path /search /answer
    acl key_ok req.hdr(x-api-key),map_str(/etc/haproxy/api-keys.map) -m found
    http-request sc-inc-gpc0(0) if api_path !key_ok
    http-request return status 401 content-type application/json string '{"error":"нужен ключ API"}' if api_path !key_ok
    # ключ дальше входа не идёт: сервису поиска он не нужен
    http-request del-header x-api-key
    http-response set-header Strict-Transport-Security "max-age=31536000"
    http-response del-header Server
    use_backend answer if { path /answer }
    default_backend search

backend search
    balance leastconn
    option httpchk
    http-check send meth GET uri /readyz
    http-check expect status 200
    retry-on conn-failure empty-response response-timeout 503
    # мёртвая машина выпадает после двух проверок подряд, примерно за 2 с
    default-server check inter 1s fastinter 500ms downinter 1s fall 2 rise 2
@SEARCH_SERVERS@

# Ответ модели идёт секунды, поэтому свой таймаут (модель 120 с, сервис 130 с, здесь 150 с).
# Повтор только если соединение не установилось: долгую генерацию не повторяем, иначе модель
# на Маке делает работу дважды. Состояние серверов берём у backend search (track).
backend answer
    balance leastconn
    timeout server 150s
    retries 1
    retry-on conn-failure
@ANSWER_SERVERS@

frontend kube-api
    mode tcp
    bind 127.0.0.1:6443
    option tcplog
    timeout client 1h
    default_backend kube-api

backend kube-api
    mode tcp
    timeout connect 1s
    timeout server 1h
    default-server check inter 2s fall 2 rise 2
@API_SERVERS@

frontend stats
    bind 127.0.0.1:8404
    stats enable
    stats uri /stats
    stats refresh 2s
    stats show-legends
